# ═══════════════════════════════════════════════════════════
#  ASTRA — modelo de variáveis de ambiente
#  Copie para .env e preencha:  cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ── MySQL (container Docker) ──
MYSQL_ROOT_PASSWORD=defina_uma_senha_forte
MYSQL_DATABASE=astra
MYSQL_USER=astra
MYSQL_PASSWORD=defina_uma_senha_forte
MYSQL_PORT=3306

# ── Aplicação / Banco (tutorial 03) ──
DATABASE_URL=mysql+pymysql://astra:defina_uma_senha_forte@localhost:3306/astra

# ── Segurança / JWT (tutorial 04) ──
# Gere uma chave forte:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere_uma_chave_hex_de_64_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
